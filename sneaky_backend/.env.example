# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=https://sneakyspeak.vercel.app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# MySQL Database URL (Cloud / Aiven / Railway / Local)
# Format: mysql://<username>:<password>@<host>:<port>/<database_name>?ssl-mode=REQUIRED
DATABASE_URL=mysql://avnadmin:your_password@your-mysql-host.aivencloud.com:12345/defaultdb?ssl-mode=REQUIRED

# Cloudinary (Media & Meme Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Nodemailer with Gmail App Password for verification codes)
EMAIL_USER=your_email@gmail.com
EMAIL_APP_PASSWORD=your_gmail_app_password

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
